@using System.Globalization
@using Alcamala.Models
@using Elysium.Components.Buttons
@using Elysium.Components.Enums
@using Elysium.Components.Inputs
@using Elysium.Components.Layout
@using Elysium.Components.Navigation
@using Elysium.Icons
@using Elysium.Utilities.LocalStorage

@inherits LayoutComponentBase

@inject LocalStorageService LocalStorageService
@inject NavigationManager NavigationManager

<div class="page">
    <ElLayout>
        <Sidebar>
            <ElSidebar Class="sidebar">
                <div class="logo">
                    @AlcamalaLogo.Icon.GetSVG("128px", "128px")
                </div>

                <div class="navigation-items">
                    <ElNavItem Href="drinks" Label="Drinks" Icon="@Icon.Cup_Straw" Style="border-radius: var(--elysium-radius-sm);" />
                    <ElNavItem Href="weight" Label="Weight" Icon="@Icon.Heart_Pulse" Style="border-radius: var(--elysium-radius-sm);" />
                </div>

                <div class="profile">
                    <ElDropdownInput T="string" Value="@CultureInfo.CurrentUICulture.ToString()" ValueChanged="@LanguageSelected" AvailableValues="@(["en", "nl"])" DropdownPosition="Position.Top" />
                    <ElTextButton Text="Log out" Click="@Logout" Variant="ButtonStyle.Outlined" Style="margin-top: var(--elysium-spacing-md);" />
                </div>
            </ElSidebar>
        </Sidebar>

        <Content>
            <main>
                @Body
            </main>
        </Content>
    
        <BottomNavBar>
            <ElBottomNavBar Class="bottom-nav-bar">
                <ElNavItem Href="drinks" Label="Drinks" LabelPosition="@Position.Bottom" Icon="@Icon.Cup_Straw" />
                <ElNavItem Href="weight" Label="Weight" LabelPosition="@Position.Bottom" Icon="@Icon.Heart_Pulse" />
            </ElBottomNavBar>
        </BottomNavBar>
    </ElLayout>
</div>

@code {
    private void Logout()
    {
        NavigationManager.NavigateTo("logout");
    }

    private async Task LanguageSelected(string language)
    {
        await LocalStorageService.SetCultureAsync(language);

        NavigationManager.NavigateTo(NavigationManager.Uri, true);
    }
}
