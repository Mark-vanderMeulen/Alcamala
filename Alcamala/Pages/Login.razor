@layout AuthenticationLayout

@attribute [AllowAnonymous]

@page "/login"

@using Elysium.Components.Buttons
@using Elysium.Components.Inputs
@using Elysium.Components.Layout

<div class="login-card" @onkeydown="@OnKeyDown">
    <ElCard Title="Login">
        <ElTextInput @bind-Value="@_email" Placeholder="@("name@email.com")" Style="margin-bottom: var(--elysium-spacing-md);" />
        <ElPasswordInput @bind-Value="@_password" Placeholder="Password" />
        
        <ElTextButton Text="Log in" Click="@TryLoginAsync" Style="margin-top: var(--elysium-spacing-lg);" />
    </ElCard>
</div>
