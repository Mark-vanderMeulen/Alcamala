@* @page "/"
@page "/drinks" *@

@using Alcamala.Models.Firestore
@using Alcamala.Services
@using Fireblaze.Firestore
@using LiveChartsCore
@using LiveChartsCore.SkiaSharpView
@using LiveChartsCore.SkiaSharpView.Blazor

@inject FirestoreService FirestoreService
@inject FirebaseAuthenticationStateProvider Auth

<PageTitle>Drinks</PageTitle>

<h1>Drinks</h1>

<button class="btn btn-primary" @onclick="GetDrinks">Get drinks</button>
<button class="btn btn-primary" @onclick="GetDrinksWhere">Get drinks where</button>
<button class="btn btn-primary" @onclick="GetDrinksAnd">Get drinks and</button>
<button class="btn btn-primary" @onclick="GetDrinksOr">Get drinks or</button>
<button class="btn btn-primary" @onclick="GetDrinksOwnedBy">Get drinks owned by</button>
<button class="btn btn-primary" @onclick="GetDrinksWhereOwnedBy">Get drinks where & owned by</button>

<div style="width: 500px; height: 500px;">
    <CartesianChart @ref="@Chart"
                    Series="@series"
                    LegendPosition="LiveChartsCore.Measure.LegendPosition.Right" />
</div>

@code {
    private CartesianChart Chart = new();

    private ISeries[] series = [
        new LineSeries<int> {
            Values = [5, 10, 8, 4],
            Name = "Mary"
        },
        new ColumnSeries<int>
        {
            Values = [4, 7, 3, 8],
            Name = "Ana"
        }
    ];

    private async Task GetDrinks()
    {
        var temp = await FirestoreService.GetCollection<Drink>().ToListAsync();
    }

    private async Task GetDrinksWhere()
    {
        var query = new WhereOperator<string>("name", Comparer.EqualTo, "Coffee");

        var temp = await FirestoreService.GetCollection<Drink>(query).ToListAsync();
    }

    private async Task GetDrinksAnd()
    {
        var where1 = new WhereOperator<string>("name", Comparer.EqualTo, "Coffee");
        var where2 = new WhereOperator<int>("amount", Comparer.EqualTo, 125);

        var and = new AndOperator(where1, where2);

        var temp = await FirestoreService.GetCollection<Drink>("drinks", and).ToListAsync();
    }

    private async Task GetDrinksOr()
    {
        var where1 = new WhereOperator<string>("name", Comparer.EqualTo, "Coffee");
        var where2 = new WhereOperator<string>("name", Comparer.EqualTo, "Tea");

        var or = new OrOperator(where1, where2);

        var temp = await FirestoreService.GetCollection<Drink>("drinks", or).ToListAsync();
    }

    private async Task GetDrinksOwnedBy()
    {
        var temp = await FirestoreService.GetCollection<Drink>("drinks").OwnedBy(Auth.CurrentUser!.Uid).ToListAsync();
    }

    private async Task GetDrinksWhereOwnedBy()
    {
        var query = new WhereOperator<string>("name", Comparer.EqualTo, "Coffee");

        var temp = await FirestoreService.GetCollection<Drink>("drinks", query).OwnedBy(Auth.CurrentUser!.Uid).ToListAsync();
    }
}
