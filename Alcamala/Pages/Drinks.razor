@using Elysium.Components.Inputs
@using Elysium.Components.Layout
@using LiveChartsCore.SkiaSharpView.Blazor

@inherits BasePage

@page "/drinks"

<PageTitle>Drinks - Alcamala</PageTitle>

@* <ElAppBar Title="Drinks" /> *@

<article class="page-content">
    <div style="display: flex; flex-direction: row;">
        <div>
            <ElDateInput Value="@_selectedDate" ValueChanged="@SelectedDateChanged" />

            <ElList Items="@_todaysDrinks.OrderBy(drink => drink.ConsumedOn)" ItemStyle="color: var(--elysium-color-on-surface);">
                <ItemTemplate Context="drink">
                    <div>@($"{drink.Name}: {drink.Amount} ({drink.ConsumedOn.ToLocalTime()})")</div>
                </ItemTemplate>
            </ElList>
        </div>
        @* <div style="width: 500px; height: 500px;">
            <CartesianChart @ref="@_chart"
                            Series="@_series"
                            LegendPosition="LiveChartsCore.Measure.LegendPosition.Right" />
        </div> *@
    </div>
</article>
